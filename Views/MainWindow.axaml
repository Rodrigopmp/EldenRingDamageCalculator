<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EldenRingDamageCalculator.ViewModels"
        xmlns:models="using:EldenRingDamageCalculator.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="800"
        x:Class="EldenRingDamageCalculator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="900"
        Height="800"
        MinWidth="700"
        MinHeight="600"
        Icon="/Assets/avalonia-logo.ico"
        Title="Elden Ring Damage Calculator">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer>

        <StackPanel
            Margin="30"
            Spacing="25">

            <TextBlock
                Text="Elden Ring Damage Calculator"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>


            <!-- ATRIBUTOS -->

            <Border
                Padding="15"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Spacing="10">

                    <TextBlock
                        Text="Atributos"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <TextBlock Text="Força"/>

                    <NumericUpDown
                        Value="{Binding Stats.Strength}"
                        Minimum="1"
                        Maximum="99"
                        FormatString="0"/>

                    <TextBlock Text="Destreza"/>

                    <NumericUpDown
                        Value="{Binding Stats.Dexterity}"
                        Minimum="1"
                        Maximum="99"
                        FormatString="0"/>

                    <TextBlock Text="Inteligência"/>

                    <NumericUpDown
                        Value="{Binding Stats.Intelligence}"
                        Minimum="1"
                        Maximum="99"
                        FormatString="0"/>

                    <TextBlock Text="Fé"/>

                    <NumericUpDown
                        Value="{Binding Stats.Faith}"
                        Minimum="1"
                        Maximum="99"
                        FormatString="0"/>

                    <TextBlock Text="Arcano"/>

                    <NumericUpDown
                        Value="{Binding Stats.Arcane}"
                        Minimum="1"
                        Maximum="99"
                        FormatString="0"/>

                </StackPanel>

            </Border>


            <!-- ARMA -->

            <Border
                Padding="15"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Arma"
                        FontSize="22"
                        FontWeight="Bold"/>


                    <TextBlock
                        Text="Pesquisar arma"/>


                    <AutoCompleteBox
                        ItemsSource="{Binding Weapons}"
                        SelectedItem="{Binding SelectedWeapon}"
                        ValueMemberBinding="{Binding Name}"
                        FilterMode="Contains"
                        MinimumPrefixLength="1"
                        PlaceholderText="Digite o nome da arma..."/>


                    <TextBlock
                        Text="{Binding WeaponCatalogStatus}"
                        FontSize="12"
                        Opacity="0.65"/>


                    <!-- CARD DA ARMA -->

                    <Border
                        Padding="12"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="{Binding SelectedWeapon.Name}"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding SelectedWeapon.Category}"/>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5">

                                <TextBlock
                                    Text="Origem:"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="{Binding SelectedWeapon.GameOriginDisplay}"/>

                            </StackPanel>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5">

                                <TextBlock
                                    Text="Material:"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="{Binding SelectedWeapon.UpgradeMaterialDisplay}"/>

                            </StackPanel>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="2">

                                <TextBlock
                                    Text="Upgrade máximo:"
                                    FontWeight="Bold"/>

                                <TextBlock Text="+"/>

                                <TextBlock
                                    Text="{Binding SelectedWeapon.MaxUpgradeLevel}"/>

                            </StackPanel>


                            <TextBlock
                                Text="Requisitos:"
                                FontWeight="Bold"
                                Margin="0,5,0,0"/>

                            <TextBlock
                                Text="{Binding SelectedWeapon.RequirementsDisplay}"
                                TextWrapping="Wrap"/>


                            <!-- AQUISIÇÃO -->

                            <Separator
                                Margin="0,10,0,8"/>


                            <TextBlock
                                Text="Como obter"
                                FontSize="18"
                                FontWeight="Bold"/>


                            <TextBlock
                                Text="{Binding SelectedWeapon.AcquisitionLocationDisplay}"
                                FontWeight="Bold"
                                TextWrapping="Wrap"/>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5">

                                <TextBlock
                                    Text="Tipo:"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="{Binding SelectedWeapon.AcquisitionMethodDisplay}"/>

                            </StackPanel>


                            <TextBlock
                                Text="{Binding SelectedWeapon.AcquisitionDescriptionDisplay}"
                                TextWrapping="Wrap"/>


                            <TextBlock
                                Text="{Binding SelectedWeapon.AcquisitionSourceDisplay}"
                                FontSize="11"
                                Opacity="0.55"/>


                            <TextBlock
                                Text="{Binding AcquisitionCatalogStatus}"
                                FontSize="11"
                                Opacity="0.55"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- UPGRADE -->

                    <TextBlock
                        Text="Nível da arma"/>

                    <NumericUpDown
                        Value="{Binding WeaponUpgradeLevel}"
                        Minimum="0"
                        Maximum="{Binding WeaponUpgradeMaximum}"
                        Increment="1"
                        FormatString="0"/>


                    <!-- CINZA DE GUERRA -->

                    <TextBlock
                        Text="Cinza de Guerra"/>

                    <ComboBox
                        ItemsSource="{Binding AshesOfWar}"
                        SelectedItem="{Binding SelectedAshOfWar}"/>


                    <!-- AFINIDADE -->

                    <TextBlock
                        Text="Afinidade"/>

                    <ComboBox
                        ItemsSource="{Binding AvailableAffinities}"
                        SelectedItem="{Binding SelectedAffinity}"
                        IsEnabled="{Binding CanSelectAffinity}"/>


                    <!-- AR -->

                    <Border
                        Margin="0,12,0,0"
                        Padding="15"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel Spacing="10">

                            <TextBlock
                                Text="Attack Rating (AR)"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding WeaponArStatus}"
                                FontSize="12"
                                Opacity="0.65"/>


                            <TextBlock
                                Text="{Binding WeaponRequirementWarning}"
                                TextWrapping="Wrap"/>


                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Physical:" Width="100"/>
                                <TextBlock Text="{Binding PhysicalBase}"/>
                                <TextBlock Text="+"/>
                                <TextBlock Text="{Binding PhysicalScaling}"/>
                                <TextBlock Text="="/>
                                <TextBlock Text="{Binding PhysicalAr}" FontWeight="Bold"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Magic:" Width="100"/>
                                <TextBlock Text="{Binding MagicBase}"/>
                                <TextBlock Text="+"/>
                                <TextBlock Text="{Binding MagicScaling}"/>
                                <TextBlock Text="="/>
                                <TextBlock Text="{Binding MagicAr}" FontWeight="Bold"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Fire:" Width="100"/>
                                <TextBlock Text="{Binding FireBase}"/>
                                <TextBlock Text="+"/>
                                <TextBlock Text="{Binding FireScaling}"/>
                                <TextBlock Text="="/>
                                <TextBlock Text="{Binding FireAr}" FontWeight="Bold"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Lightning:" Width="100"/>
                                <TextBlock Text="{Binding LightningBase}"/>
                                <TextBlock Text="+"/>
                                <TextBlock Text="{Binding LightningScaling}"/>
                                <TextBlock Text="="/>
                                <TextBlock Text="{Binding LightningAr}" FontWeight="Bold"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Holy:" Width="100"/>
                                <TextBlock Text="{Binding HolyBase}"/>
                                <TextBlock Text="+"/>
                                <TextBlock Text="{Binding HolyScaling}"/>
                                <TextBlock Text="="/>
                                <TextBlock Text="{Binding HolyAr}" FontWeight="Bold"/>
                            </StackPanel>


                            <Separator/>


                            <StackPanel Orientation="Horizontal" Spacing="10">

                                <TextBlock
                                    Text="TOTAL AR:"
                                    FontSize="18"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="{Binding WeaponTotalAr}"
                                    FontSize="24"
                                    FontWeight="Bold"/>

                            </StackPanel>


                            <TextBlock
                                Text="Attribute Scaling"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,8,0,0"/>


                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="15">

                                <TextBlock>
                                    <Run Text="STR: "/>
                                    <Run Text="{Binding StrengthScalingDisplay}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="DEX: "/>
                                    <Run Text="{Binding DexterityScalingDisplay}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="INT: "/>
                                    <Run Text="{Binding IntelligenceScalingDisplay}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="FAI: "/>
                                    <Run Text="{Binding FaithScalingDisplay}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="ARC: "/>
                                    <Run Text="{Binding ArcaneScalingDisplay}"/>
                                </TextBlock>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>


            <!-- TALISMÃS -->

            <Border Padding="15" BorderThickness="1" CornerRadius="8">

                <StackPanel Spacing="10">

                    <TextBlock
                        Text="Talismãs"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <TextBlock Text="Slot 1"/>

                    <ComboBox
                        ItemsSource="{Binding Talismans}"
                        SelectedItem="{Binding SelectedTalisman1}"/>

                    <TextBlock Text="Slot 2"/>

                    <ComboBox
                        ItemsSource="{Binding Talismans}"
                        SelectedItem="{Binding SelectedTalisman2}"/>

                    <TextBlock Text="Slot 3"/>

                    <ComboBox
                        ItemsSource="{Binding Talismans}"
                        SelectedItem="{Binding SelectedTalisman3}"/>

                    <TextBlock Text="Slot 4"/>

                    <ComboBox
                        ItemsSource="{Binding Talismans}"
                        SelectedItem="{Binding SelectedTalisman4}"/>

                </StackPanel>

            </Border>


            <!-- BUFFS -->

            <Border Padding="15" BorderThickness="1" CornerRadius="8">

                <StackPanel Spacing="15">

                    <TextBlock
                        Text="Buffs"
                        FontSize="22"
                        FontWeight="Bold"/>


                    <TextBlock
                        Text="Aura Buffs"
                        FontSize="18"
                        FontWeight="Bold"/>


                    <ItemsControl ItemsSource="{Binding AuraBuffs}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:Buff">

                                <CheckBox
                                    IsChecked="{Binding IsSelected}"
                                    Margin="0,4">

                                    <StackPanel Orientation="Horizontal" Spacing="4">

                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text=":"/>
                                        <TextBlock Text="{Binding DamageBonusPercent}"/>
                                        <TextBlock Text="%"/>

                                    </StackPanel>

                                </CheckBox>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>


                    <TextBlock
                        Text="Body Buffs"
                        FontSize="18"
                        FontWeight="Bold"
                        Margin="0,10,0,0"/>


                    <ItemsControl ItemsSource="{Binding BodyBuffs}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:Buff">

                                <CheckBox
                                    IsChecked="{Binding IsSelected}"
                                    Margin="0,4">

                                    <StackPanel Orientation="Horizontal" Spacing="4">

                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text=":"/>
                                        <TextBlock Text="{Binding DamageBonusPercent}"/>
                                        <TextBlock Text="%"/>

                                    </StackPanel>

                                </CheckBox>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>


            <!-- ARMADURA -->

            <Border Padding="15" BorderThickness="1" CornerRadius="8">

                <StackPanel Spacing="10">

                    <TextBlock
                        Text="Armadura"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <TextBlock Text="Cabeça"/>

                    <ComboBox
                        ItemsSource="{Binding HeadArmor}"
                        SelectedItem="{Binding SelectedHeadArmor}"/>

                    <TextBlock Text="Peitoral"/>

                    <ComboBox
                        ItemsSource="{Binding ChestArmor}"
                        SelectedItem="{Binding SelectedChestArmor}"/>

                    <TextBlock Text="Braços"/>

                    <ComboBox
                        ItemsSource="{Binding ArmArmor}"
                        SelectedItem="{Binding SelectedArmArmor}"/>

                    <TextBlock Text="Pernas"/>

                    <ComboBox
                        ItemsSource="{Binding LegArmor}"
                        SelectedItem="{Binding SelectedLegArmor}"/>

                </StackPanel>

            </Border>


            <!-- BOSS -->

            <Border Padding="15" BorderThickness="1" CornerRadius="8">

                <StackPanel Spacing="10">

                    <TextBlock
                        Text="Boss / Alvo"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <TextBlock Text="Boss"/>

                    <ComboBox
                        ItemsSource="{Binding Bosses}"
                        SelectedItem="{Binding SelectedBoss}"/>

                    <TextBlock Text="Fase"/>

                    <ComboBox
                        ItemsSource="{Binding BossPhases}"
                        SelectedItem="{Binding SelectedBossPhase}"/>

                </StackPanel>

            </Border>


            <!-- QUICK DAMAGE -->

            <Border Padding="15" BorderThickness="1" CornerRadius="8">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Quick Damage Calculator"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <TextBlock Text="Dano sem buffs:"/>

                    <NumericUpDown
                        Value="{Binding BaseDamage}"
                        Minimum="0"/>

                    <Button
                        Content="Calcular dano"
                        Command="{Binding CalculateDamageCommand}"
                        HorizontalAlignment="Center"
                        Padding="25,10"/>

                    <TextBlock
                        Text="{Binding ValidationMessage}"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Dano final:"
                        FontWeight="Bold"
                        FontSize="18"/>

                    <TextBlock
                        Text="{Binding FinalDamage}"
                        FontSize="28"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Window>